<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Raw Materials List View -->
    <record id="mrp_production_form_view_raw_materials_secondary_unit" model="ir.ui.view">
        <field name="name">mrp.production.raw.materials.secondary.unit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/list//field[@name='product_id']" position="after">
                <field name="secondary_uom_id" options="{'no_create': True}" optional="hide"/>
                <field name="secondary_uom_qty" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Finished Products List View -->
    <record id="mrp_production_form_view_finished_products_secondary_unit" model="ir.ui.view">
        <field name="name">mrp.production.finished.products.secondary.unit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_finished_ids']/list//field[@name='product_id']" position="after">
                <field name="secondary_uom_id" options="{'no_create': True}" optional="hide"/>
                <field name="secondary_uom_qty" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>

