<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view_secondary_unit" model="ir.ui.view">
        <field name="name">MRP Production Form with Secondary Unit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <field name="product_qty" position="after">
                <field name="secondary_uom_id" />
                <field name="secondary_uom_qty" />
            </field>
        </field>
    </record>

    <record id="mrp_production_form_view_raw_materials_secondary_unit" model="ir.ui.view">
        <field name="name">MRP Production Form Raw Materials with Secondary Unit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']//field[@name='product_uom_qty']" position="after">
                <field name="secondary_uom_id" />
                <field name="secondary_uom_qty" />
            </xpath>
        </field>
    </record>

    <record id="mrp_production_form_view_finished_products_secondary_unit" model="ir.ui.view">
        <field name="name">MRP Production Form Finished Products with Secondary Unit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_finished_ids']//field[@name='product_uom_qty']" position="after">
                <field name="secondary_uom_id" />
                <field name="secondary_uom_qty" />
            </xpath>
        </field>
    </record>
</odoo>

