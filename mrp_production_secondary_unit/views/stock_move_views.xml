<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_secondary_unit" model="ir.ui.view">
        <field name="name">stock.move.form - Secondary Unit</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form" />
        <field name="arch" type="xml">
            <field name="product_uom_qty" position="after">
                <field name="secondary_uom_id" 
                       invisible="not (production_id or raw_material_production_id)" />
                <field name="secondary_uom_qty" 
                       invisible="not (production_id or raw_material_production_id)" />
            </field>
        </field>
    </record>
</odoo>

