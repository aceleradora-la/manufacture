<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Create Production Analysis Pivot View with secondary unit quantities -->
    <!-- This view will be available when users switch to pivot view in production orders -->
    <record id="view_mrp_production_pivot_secondary_unit" model="ir.ui.view">
        <field name="name">mrp.production.pivot.secondary.unit</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <pivot string="Production Analysis">
                <field name="product_id" type="row"/>
                <field name="state" type="row"/>
                <field name="date_start" interval="month" type="col"/>
                <field name="product_qty" type="measure" string="Quantity"/>
                <field name="secondary_uom_qty" type="measure" string="Secondary Quantity"/>
            </pivot>
        </field>
    </record>
    
    <!-- Ensure pivot view is available in the action -->
    <!-- Inherit the standard mrp.production action to ensure pivot is in view_mode -->
    <record id="mrp_production_action_secondary_unit" model="ir.actions.act_window">
        <field name="inherit_id" ref="mrp.mrp_production_action"/>
        <field name="view_mode">tree,form,calendar,pivot,graph,kanban</field>
    </record>
</odoo>

